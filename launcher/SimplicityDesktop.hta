<!doctype html>
<html><head><meta http-equiv="X-UA-Compatible" content="IE=9"><title>SimplicityBRS</title>
<hta:application id="recovery" applicationname="SimplicityBRS" icon="X:\RecoveryPE\SimplicityBRS.ico" border="thin" caption="yes" singleinstance="yes" scroll="no" />
<style>body{background:#000000;color:#edf3fa;font-family:Segoe UI;padding:32px}h1{font-size:32px;margin-bottom:4px}p{color:#b9c9da}button{display:block;width:100%;text-align:left;padding:15px;margin:12px 0;background:#0047AB;color:white;border:1px solid #2475D7;font:18px Segoe UI;cursor:pointer}.note{font-size:13px;margin-top:24px}</style>
<script language="JScript">
var shell=new ActiveXObject('WScript.Shell');
function run(command){try{shell.Run(command,1,false);}catch(e){alert('Unable to open tool: '+e.message);}}
function diskReport(){run('cmd.exe /k diskpart.exe /s X:\\RecoveryPE\\list-disks.txt');}
window.onload=function(){window.resizeTo(720,680);shell.Run('X:\\RecoveryPE\\LauncherOpacity.exe',0,false);};
</script></head><body><h1>SimplicityBRS</h1><p>Backup and Recovery Suite &middot; Backup and Recovery Suite</p>
<button onclick="run('explorer.exe')">File Manager</button><button onclick="diskReport()">Inspect disks and volumes</button>
<button onclick="run('cmd.exe /k ipconfig /all')">Network information</button>
<button onclick="run('wscript.exe //nologo X:\\RecoveryPE\\LaunchApp.vbs notepadpp')">Notepad++</button>
<button onclick="run('cmd.exe')">Command prompt</button>
<button onclick="if(confirm('Shut down this recovery environment?'))run('wpeutil.exe shutdown')">Shut down</button>
<p class="note">Disk inspection only lists information. Commands entered manually in the command prompt can modify disks.</p></body></html>



