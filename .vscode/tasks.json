      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/Get-Dependencies.ps1"],
      "problemMatcher": []
    }
  ]
}
